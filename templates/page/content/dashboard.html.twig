{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}

    {% block page_content_navbar %}
        {% include 'layout/navbar/navbar.html.twig' %}
    {% endblock %}

    <div class="container mt-5">

        <div class="row g-4">

            <div class="col-lg-8">

                <div class="card border-0 shadow-sm mb-4 overflow-hidden">
                    <div class="card-header bg-primary text-white py-3">
                        <h5 class="mb-0"><i class="bi bi-megaphone me-2"></i>Aktuellste Umfrage</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h2 class="card-title fw-bold">Wie zufrieden bist du mit unserem Service?</h2>
                            <span class="badge bg-success">Aktiv</span>
                        </div>
                        <p class="text-muted mb-4">
                            Deine Meinung ist uns wichtig! Nimm an unserer monatlichen Feedback-Runde teil.
                        </p>

                        <div class="mb-4">
                            <div class="d-flex justify-content-between mb-1 small">
                                <span>Bisherige Stimmen</span>
                                <span>452 Stimmen</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-info" style="width: 75%"></div>
                            </div>
                        </div>

                        <a href="#" class="btn btn-primary px-4 shadow-sm">Jetzt abstimmen</a>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm text-center p-3 h-100">
                            <div class="text-primary fs-1 mb-2"><i class="bi bi-journal-check"></i></div>
                            <h3 class="fw-bold mb-0">24</h3>
                            <p class="text-muted small mb-0">Umfragen gesamt</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm text-center p-3 h-100">
                            <div class="text-success fs-1 mb-2"><i class="bi bi-people"></i></div>
                            <h3 class="fw-bold mb-0">1.250</h3>
                            <p class="text-muted small mb-0">Registrierte User</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm text-center p-3 h-100">
                            <div class="text-warning fs-1 mb-2"><i class="bi bi-lightning-charge"></i></div>
                            <h3 class="fw-bold mb-0">8.942</h3>
                            <p class="text-muted small mb-0">Abgegebene Votes</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white fw-bold py-3">
                        <i class="bi bi-trophy text-warning me-2"></i>Top 3 Voter
                    </div>
                    <div class="list-group list-group-flush">
                        <div class="list-group-item d-flex align-items-center">
                            <span class="badge bg-warning rounded-circle me-3" style="width: 24px; height: 24px;">1</span>
                            <div class="flex-grow-1">
                                <div class="fw-bold">Max_Power</div>
                                <small class="text-muted">Profi-Voter</small>
                            </div>
                            <span class="badge bg-light text-dark">152 Votes</span>
                        </div>
                        <div class="list-group-item d-flex align-items-center">
                            <span class="badge bg-secondary rounded-circle me-3" style="width: 24px; height: 24px;">2</span>
                            <div class="flex-grow-1">
                                <div class="fw-bold">Lisa_Voter</div>
                                <small class="text-muted">Kunde</small>
                            </div>
                            <span class="badge bg-light text-dark">128 Votes</span>
                        </div>
                        <div class="list-group-item d-flex align-items-center">
                            <span class="badge rounded-circle me-3" style="background-color: #cd7f32; color: white; width: 24px; height: 24px;">3</span>
                            <div class="flex-grow-1">
                                <div class="fw-bold">The_Machine</div>
                                <small class="text-muted">Kunde</small>
                            </div>
                            <span class="badge bg-light text-dark">94 Votes</span>
                        </div>
                    </div>
                </div>

                <div class="card border-0 bg-dark text-white shadow-sm overflow-hidden">
                    <div class="card-body p-4 text-center">
                        <h4 class="fw-bold mb-3 text-white">Mitmachen</h4>
                        <p class="small text-white-50 mb-4">
                            Werde Kunde und schalte exklusive Badges frei.
                        </p>
                        <div class="d-grid gap-2">
                            <a href="#" class="btn btn-primary">Registrieren</a>
                            <a href="#" class="btn btn-outline-light">Login</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
{% endblock %}
