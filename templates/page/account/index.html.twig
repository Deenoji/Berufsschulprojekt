{% extends 'base.html.twig' %}

{% block title %}Account{% endblock %}

{% block body %}

    {% block page_content_navbar %}
        {% include 'layout/navbar/navbar.html.twig' %}
    {% endblock %}

    <div class="container mt-5">
        <div class="row g-4">

            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3 border-bottom-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="fw-bold mb-0 text-primary">Umfrage: Mobilität 2026</h4>
                            <span class="text-muted small">Frage 3 von 5</span>
                        </div>
                        <div class="progress mt-3" style="height: 6px;">
                            <div class="progress-bar bg-primary" style="width: 60%"></div>
                        </div>
                    </div>

                    <div class="card-body p-4 p-md-5">
                        <div class="mb-5">
                            <h3 class="fw-bold mb-4">Welches Verkehrsmittel nutzen Sie am häufigsten für den Arbeitsweg?</h3>

                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="selection-card p-3 border rounded d-flex align-items-center">
                                        <input type="radio" name="vote_option" class="form-check-input me-3">
                                        <div class="d-flex align-items-center">
                                            <div class="icon-box bg-light rounded p-2 me-3">
                                                <i class="bi bi-car-front fs-4 text-primary"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold">Privat-PKW</div>
                                                <small class="text-muted">Alleinige Nutzung des Autos</small>
                                            </div>
                                        </div>
                                    </label>
                                </div>

                                <div class="col-12">
                                    <label class="selection-card p-3 border rounded d-flex align-items-center selected">
                                        <input type="radio" name="vote_option" class="form-check-input me-3" checked>
                                        <div class="d-flex align-items-center">
                                            <div class="icon-box bg-light rounded p-2 me-3">
                                                <i class="bi bi-bus-front fs-4 text-primary"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold">Öffentlicher Nahverkehr</div>
                                                <small class="text-muted">Bus, Bahn oder Tram</small>
                                            </div>
                                        </div>
                                    </label>
                                </div>

                                <div class="col-12">
                                    <label class="selection-card p-3 border rounded d-flex align-items-center">
                                        <input type="radio" name="vote_option" class="form-check-input me-3">
                                        <div class="d-flex align-items-center">
                                            <div class="icon-box bg-light rounded p-2 me-3">
                                                <i class="bi bi-bicycle fs-4 text-primary"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold">Fahrrad / E-Bike</div>
                                                <small class="text-muted">Muskelkraft oder elektrisch unterstützt</small>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Möchten Sie uns noch etwas dazu sagen?</label>
                            <textarea class="form-control" rows="3" placeholder="Optionaler Kommentar..."></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <button class="btn btn-outline-secondary px-4 py-2">Zurück</button>
                            <button class="btn btn-primary px-5 py-2 fw-bold shadow-sm">Nächste Frage <i class="bi bi-arrow-right ms-2"></i></button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm bg-primary text-white mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">Dein Status</h5>
                        <div class="d-flex align-items-center mb-4">
                            <div class="badge-icon me-3 bg-white text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                <i class="bi bi-trophy-fill fs-2"></i>
                            </div>
                            <div>
                                <div class="h4 mb-0 fw-bold">Level 4</div>
                                <div class="opacity-75">Profi-Voter</div>
                            </div>
                        </div>

                        <div class="mb-2 d-flex justify-content-between small">
                            <span>Noch 3 Votes bis Level 5</span>
                            <span>12/15</span>
                        </div>
                        <div class="progress bg-white bg-opacity-25 shadow-sm" style="height: 10px;">
                            <div class="progress-bar bg-white" style="width: 80%"></div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3"><i class="bi bi-info-circle text-primary me-2"></i>Deine Belohnung</h6>
                        <p class="small text-muted mb-0">
                            Für jede abgeschlossene Umfrage erhältst du <strong>1 Vote-Punkt</strong>.
                            Sammle Punkte, um exklusive Badges freizuschalten und deine Meinung in der Statistik stärker zu gewichten.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <style>
        /* Styling für die Antwort-Karten */
        .selection-card {
            cursor: pointer;
            transition: all 0.2s ease-in-out;
            border: 2px solid #e9ecef !important;
        }
        .selection-card:hover {
            background-color: #f8f9fa;
            border-color: #dee2e6 !important;
        }
        .selection-card.selected {
            border-color: #0d6efd !important;
            background-color: #f0f7ff;
        }
        /* Die Radio-Buttons verstecken oder stylen */
        .selection-card input[type="radio"] {
            width: 20px;
            height: 20px;
        }
    </style>

{% endblock %}
