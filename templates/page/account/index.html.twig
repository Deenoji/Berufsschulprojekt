{% extends 'base.html.twig' %}

{% block title %}Account{% endblock %}

{% block body %}

    {% block page_content_navbar %}
        {% include 'layout/navbar/navbar.html.twig' %}
    {% endblock %}

    <div class="container mt-5">

        <div class="d-flex align-items-center mb-4">
            <div>
                <h1 class="fw-bold mb-1">{{ app.user.displayName }}</h1>
                <p class="text-muted mb-0">{{ app.user.userIdentifier }}</p>
            </div>
        </div>

        <div class="row g-4">

            {# --- LINKS: Teilgenommene Umfragen --- #}
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3 fw-bold border-bottom-0">
                        <i class="bi bi-clipboard-check text-primary me-2"></i>Meine Umfragen
                        <span class="badge bg-light text-dark ms-2">{{ participated|length }}</span>
                    </div>
                    <ul class="list-group list-group-flush">
                        {% for item in participated %}
                            <li class="list-group-item p-4">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="fw-bold mb-0">{{ item.survey.title }}</h5>
                                    {% if item.is_active %}
                                        <span class="badge bg-success-soft text-success border border-success">Aktiv</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Abgeschlossen</span>
                                    {% endif %}
                                </div>
                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    <span class="badge bg-light text-dark fw-normal">
                                        <i class="bi bi-tag me-1"></i> {{ item.category }}
                                    </span>
                                    <span class="text-muted small">
                                        <i class="bi bi-calendar3 me-1"></i>
                                        Bis {{ item.survey.endDate ? item.survey.endDate|date('d.m.Y') : '—' }}
                                    </span>
                                </div>
                                {% if item.choices is not empty %}
                                    <div class="small">
                                        <span class="text-muted">Deine Wahl:</span>
                                        {% for choice in item.choices %}
                                            <span class="badge bg-primary-subtle text-primary border">{{ choice }}</span>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </li>
                        {% else %}
                            <li class="list-group-item p-5 text-center text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>
                                Du hast noch an keiner Umfrage teilgenommen.
                                <div class="mt-3">
                                    <a href="{{ path('survey') }}" class="btn btn-sm btn-primary">Zu den Umfragen</a>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>

            {# --- RECHTS: Status, Rang, Badge, Fortschritt --- #}
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm bg-primary text-white mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold mb-0">Dein Status</h5>
                            <span class="badge bg-white text-primary">Rolle: {{ role_label }}</span>
                        </div>

                        <div class="d-flex align-items-center mb-4">
                            <div class="badge-icon me-3 bg-white text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                <i class="bi {{ rank.icon }} fs-2"></i>
                            </div>
                            <div>
                                <div class="h4 mb-0 fw-bold">Level {{ rank.level }}</div>
                                <div class="opacity-75">{{ rank.name }}</div>
                            </div>
                        </div>

                        {% if rank.is_max %}
                            <div class="mb-2 small fw-bold">
                                <i class="bi bi-stars me-1"></i> Maximaler Rang erreicht!
                            </div>
                            <div class="progress bg-white bg-opacity-25 shadow-sm" style="height: 10px;">
                                <div class="progress-bar bg-white" style="width: 100%"></div>
                            </div>
                            <div class="small mt-2 opacity-75">{{ vote_count }} Votes gesammelt</div>
                        {% else %}
                            <div class="mb-2 d-flex justify-content-between small">
                                <span>Noch {{ rank.votes_to_next }} Votes bis {{ rank.next_name }}</span>
                                <span>{{ vote_count }}/{{ rank.next_min }}</span>
                            </div>
                            <div class="progress bg-white bg-opacity-25 shadow-sm" style="height: 10px;">
                                <div class="progress-bar bg-white" style="width: {{ rank.progress }}%"></div>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3"><i class="bi bi-info-circle text-primary me-2"></i>Deine Belohnung</h6>
                        <p class="small text-muted mb-0">
                            Für jede Umfrage, an der du teilnimmst, erhältst du <strong>1 Vote-Punkt</strong>.
                            Sammle Punkte, um höhere Ränge und exklusive Badges freizuschalten.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <style>
        .bg-success-soft { background-color: rgba(25, 135, 84, 0.1); }
    </style>

{% endblock %}
