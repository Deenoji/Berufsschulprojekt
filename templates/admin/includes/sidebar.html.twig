{# Wiederverwendbare Admin-Sidebar.
   Parameter: active = 'dashboard' | 'surveys' | 'users' #}
{% set active = active|default('dashboard') %}

<nav class="col-md-3 col-lg-2 d-md-block bg-white sidebar shadow-sm rounded p-3 mb-4">
    <div class="position-sticky">
        <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-2 text-muted text-uppercase small">
            <span>Verwaltung</span>
        </h6>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link {{ active == 'dashboard' ? 'active fw-bold text-primary' : 'text-dark' }}" href="{{ path('admin') }}">
                    <i class="bi bi-speedometer2 me-2"></i> Admin-Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link {{ active == 'surveys' ? 'active fw-bold text-primary' : 'text-dark' }}" href="{{ path('surveyManagement') }}">
                    <i class="bi bi-list-check me-2"></i> Umfrage-Management
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link {{ active == 'users' ? 'active fw-bold text-primary' : 'text-dark' }}" href="{{ path('userManagement') }}">
                    <i class="bi bi-people me-2"></i> Benutzer-Management
                </a>
            </li>
        </ul>
    </div>
</nav>
