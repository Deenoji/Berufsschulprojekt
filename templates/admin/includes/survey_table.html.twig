{# Wiederverwendbare Umfragen-Tabelle.
   Parameter: surveys (Survey[]) #}
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 fw-bold">
        <i class="bi bi-pencil-square me-2 text-primary"></i>Umfragen
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>Titel</th>
                <th>Kategorien</th>
                <th>Laufzeit</th>
                <th>Status</th>
                <th class="text-end">Aktion</th>
            </tr>
            </thead>
            <tbody>
            {% for survey in surveys %}
                <tr>
                    <td><span class="fw-bold">{{ survey.title }}</span></td>
                    <td>
                        <div class="d-flex flex-wrap gap-1">
                            {% set cats = survey_categories[survey.id]|default([{ 'id': survey.categoryId, 'title': category_map[survey.categoryId]|default('—') }]) %}
                            {% for category in cats %}
                                <span class="badge bg-light text-dark">{{ category.title }}</span>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endfor %}
                        </div>
                    </td>
                    <td>
                        <small>
                            {{ survey.startDate ? survey.startDate|date('d.m.Y') : '' }}
                            –
                            {{ survey.endDate ? survey.endDate|date('d.m.Y') : '' }}
                        </small>
                    </td>
                    <td>
                        {% if survey.status == 'ACTIVE' %}
                            <span class="badge bg-success-soft text-success border border-success">Aktiv</span>
                        {% else %}
                            <span class="badge bg-secondary">{{ survey.status|capitalize }}</span>
                        {% endif %}
                    </td>
                    <td class="text-end">
                        <a href="{{ path('editSurvey', { id: survey.id }) }}" class="btn btn-sm btn-outline-secondary" title="Bearbeiten">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form action="{{ path('deleteSurvey', { id: survey.id }) }}" method="post"
                              class="d-inline"
                              onsubmit="return confirm('Diese Umfrage wirklich löschen?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_survey_' ~ survey.id) }}">
                            <button class="btn btn-sm btn-outline-danger" title="Löschen">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">
                        Noch keine Umfragen vorhanden.
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
