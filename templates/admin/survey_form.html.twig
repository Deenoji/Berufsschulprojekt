{% block survey_form %}
    <div class="modal fade" id="addSurveyModal" tabindex="-1" aria-labelledby="addSurveyModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <form action="{{ path('addSurvey') }}" method="POST">
                    <div class="modal-header bg-dark text-white">
                        <h5 class="modal-title" id="addSurveyModalLabel">
                            <i class="bi bi-file-earmark-plus me-2"></i>Neue Umfrage konfigurieren
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body p-4">
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label class="form-label fw-bold">Titel der Umfrage</label>
                                <input type="text" class="form-control" name="survey_title" placeholder="z.B. Zufriedenheit Stadtpark">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">Kategorien <small class="text-muted fw-normal">(eine oder mehrere)</small></label>
                                {% if categories is empty %}
                                    <div class="text-muted small">Noch keine Kategorien vorhanden – lege zuerst eine an.</div>
                                {% else %}
                                    <div class="d-flex flex-wrap gap-2">
                                        {% for category in categories %}
                                            <input type="checkbox" class="btn-check" name="category[]"
                                                   id="form-cat-{{ category.id }}" value="{{ category.id }}" autocomplete="off">
                                            <label class="btn btn-outline-secondary btn-sm" for="form-cat-{{ category.id }}">
                                                <i class="bi bi-tag me-1"></i>{{ category.title }}
                                            </label>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Kurzbeschreibung</label>
                            <textarea class="form-control" name="survey_description" rows="2" placeholder="Worum geht es in dieser Umfrage?"></textarea>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Startdatum</label>
                                <input type="date" name="start_date" class="form-control">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Enddatum</label>
                                <input type="date" name="end_date" class="form-control">
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="bg-light p-3 rounded">
                            <h6 class="mb-3 fw-bold"><i class="bi bi-question-circle me-2"></i>Frage-Konfiguration</h6>

                            <div class="card border-0 shadow-sm mb-3">
                                <div class="card-body">
                                    <div class="mb-3">
                                        <input type="text" class="form-control fw-bold" name="question" placeholder="Frage eingeben (z.B. Wie finden Sie den neuen Brunnen?)">
                                    </div>

                                    {# Optionen: Start mit 2, per JS bis max. 4 #}
                                    <div id="optionsContainer" class="ms-3">
                                        <div class="input-group input-group-sm mb-2 option-row">
                                            <span class="input-group-text option-letter" style="width: 38px; justify-content: center;">A</span>
                                            <input type="text" class="form-control" name="option[]" placeholder="Antwortmöglichkeit">
                                            <button type="button" class="btn btn-outline-danger remove-option" title="Entfernen"><i class="bi bi-trash"></i></button>
                                        </div>
                                        <div class="input-group input-group-sm mb-2 option-row">
                                            <span class="input-group-text option-letter" style="width: 38px; justify-content: center;">B</span>
                                            <input type="text" class="form-control" name="option[]" placeholder="Antwortmöglichkeit">
                                            <button type="button" class="btn btn-outline-danger remove-option" title="Entfernen"><i class="bi bi-trash"></i></button>
                                        </div>
                                    </div>

                                    <button type="button" id="addOption" class="btn btn-link btn-sm text-decoration-none ps-3">
                                        + Option hinzufügen <span class="text-muted">(max. 4)</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer bg-light border-top-0 p-3">
                        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Abbrechen</button>
                        <button type="submit" class="btn btn-primary px-4">Umfrage live schalten</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const container = document.getElementById('optionsContainer');
            const addBtn = document.getElementById('addOption');
            if (!container || !addBtn) {
                return;
            }

            const MAX = 4;
            const MIN = 2;
            const letters = ['A', 'B', 'C', 'D'];

            function refresh() {
                const rows = container.querySelectorAll('.option-row');
                rows.forEach(function (row, i) {
                    row.querySelector('.option-letter').textContent = letters[i] || (i + 1);
                    // Entfernen nur erlauben, solange mehr als MIN vorhanden sind.
                    row.querySelector('.remove-option').disabled = rows.length <= MIN;
                });
                addBtn.disabled = rows.length >= MAX;
                addBtn.classList.toggle('disabled', rows.length >= MAX);
            }

            addBtn.addEventListener('click', function () {
                const rows = container.querySelectorAll('.option-row');
                if (rows.length >= MAX) {
                    return;
                }
                const row = document.createElement('div');
                row.className = 'input-group input-group-sm mb-2 option-row';
                row.innerHTML =
                    '<span class="input-group-text option-letter" style="width: 38px; justify-content: center;"></span>' +
                    '<input type="text" class="form-control" name="option[]" placeholder="Antwortmöglichkeit">' +
                    '<button type="button" class="btn btn-outline-danger remove-option" title="Entfernen"><i class="bi bi-trash"></i></button>';
                container.appendChild(row);
                refresh();
            });

            container.addEventListener('click', function (e) {
                const btn = e.target.closest('.remove-option');
                if (!btn) {
                    return;
                }
                const rows = container.querySelectorAll('.option-row');
                if (rows.length <= MIN) {
                    return;
                }
                btn.closest('.option-row').remove();
                refresh();
            });

            refresh();
        });
    </script>
{% endblock %}
