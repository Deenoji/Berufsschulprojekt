{% extends 'base.html.twig' %}

{% block title %}Administration{% endblock %}

{% block body %}
    {% block page_content_navbar %}
        {% include 'layout/navbar/navbar.html.twig' %}
    {% endblock %}

    <div class="container-fluid mt-4">
        <div class="row">
            {% include 'admin/includes/sidebar.html.twig' with { active: 'dashboard' } %}

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">

                {% include 'admin/includes/flash.html.twig' %}

                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2 fw-bold">Admin-Zentrale</h1>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <a class="btn btn-sm btn-primary" href="{{ path('surveyManagement') }}">
                            <i class="bi bi-plus-lg me-1"></i> Neue Umfrage erstellen
                        </a>
                    </div>
                </div>

                {# --- Statistik-Karten (echte Daten) --- #}
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm bg-primary text-white p-3">
                            <small class="opacity-75">Aktive Umfragen</small>
                            <h2 class="fw-bold mb-0">{{ stats.active }}</h2>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm p-3">
                            <small class="text-muted">Umfragen gesamt</small>
                            <h2 class="fw-bold mb-0 text-success">{{ stats.total }}</h2>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm p-3">
                            <small class="text-muted">Offene Aufstufungen</small>
                            <h2 class="fw-bold mb-0 text-warning">{{ pending_upgrades|length }}</h2>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-xl-8">
                        {% include 'admin/includes/survey_table.html.twig' with {
                            surveys: surveys,
                            category_map: category_map,
                            survey_categories: survey_categories,
                        } %}
                    </div>

                    {# --- Aufstufungsanfragen --- #}
                    <div class="col-xl-4">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white py-3 fw-bold">
                                <i class="bi bi-person-up me-2 text-warning"></i>Aufstufungsanfragen
                                <span class="badge bg-light text-dark ms-1">{{ pending_upgrades|length }}</span>
                            </div>
                            <ul class="list-group list-group-flush">
                                {% for candidate in pending_upgrades %}
                                    <li class="list-group-item p-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="fw-bold text-truncate">{{ candidate.email }}</span>
                                            <small class="text-muted">Nutzer <i class="bi bi-arrow-right"></i> Kunde</small>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <form action="{{ path('acceptUpgrade', { id: candidate.id }) }}" method="post" class="w-100">
                                                <input type="hidden" name="_token" value="{{ csrf_token('upgrade_' ~ candidate.id) }}">
                                                <button class="btn btn-sm btn-success w-100" type="submit">Freigeben</button>
                                            </form>
                                            <form action="{{ path('rejectUpgrade', { id: candidate.id }) }}" method="post" class="w-100">
                                                <input type="hidden" name="_token" value="{{ csrf_token('upgrade_' ~ candidate.id) }}">
                                                <button class="btn btn-sm btn-outline-danger w-100" type="submit">Ablehnen</button>
                                            </form>
                                        </div>
                                    </li>
                                {% else %}
                                    <li class="list-group-item p-3 text-center text-muted small">
                                        Keine offenen Aufstufungsanfragen.
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <style>
        .bg-success-soft { background-color: rgba(25, 135, 84, 0.1); }
        .nav-link:hover { background-color: #f8f9fa; border-radius: 5px; }
    </style>
{% endblock %}
